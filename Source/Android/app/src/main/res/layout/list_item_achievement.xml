<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_achievement"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    android:orientation="horizontal"
    android:background="@drawable/achievement_card"
    android:padding="@dimen/spacing_medium">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_badge"
        android:layout_width="@dimen/achievement_badge_size"
        android:layout_height="@dimen/achievement_badge_size"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:contentDescription="@null"
        android:padding="@dimen/achievement_badge_stroke"
        android:scaleType="fitCenter"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Dolphin.AchievementBadge"
        app:strokeWidth="@dimen/achievement_badge_stroke"
        tools:src="@drawable/no_banner" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Perfect Campaign" />

            <TextView
                android:id="@+id/text_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medlarge"
                android:textColor="?attr/colorSecondary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="25 points" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:alpha="0.7"
            android:textAlignment="viewStart"
            android:textColor="?attr/colorTertiary"
            android:textSize="14sp"
            tools:text="Clear every stage without missing a beat." />

        <LinearLayout
            android:id="@+id/layout_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_badge_type"
                style="@style/AchievementBadge"
                tools:backgroundTint="@color/cheevo_badge_missable"
                tools:text="Missable" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_measured_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:alpha="0.7"
            android:textAlignment="viewStart"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            tools:text="6/10" />

    </LinearLayout>

</LinearLayout>
