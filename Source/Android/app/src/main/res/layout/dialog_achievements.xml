<?xml version="1.0" encoding="utf-8"?>
<!-- Fills the screen on top of the running game, on the regular dialog surface. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:background="?attr/colorSurface"
    android:layout_margin="@dimen/spacing_small"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_medlarge"
        android:paddingEnd="@dimen/spacing_medlarge"
        android:paddingTop="@dimen/spacing_medlarge"
        android:paddingBottom="@dimen/spacing_medlarge">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/button_close"
                android:layout_width="@dimen/achievement_close_button_size"
                android:layout_height="@dimen/achievement_close_button_size"
                android:layout_gravity="end|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_clear" />

        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_achievements"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_medlarge"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbarSize="4dp"
            android:scrollbars="vertical"
            tools:itemCount="4"
            tools:listitem="@layout/list_item_achievement" />

    </LinearLayout>

</FrameLayout>
